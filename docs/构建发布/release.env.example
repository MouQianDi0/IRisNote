# Copy this template to the project root as .env.release.local, then fill it in.
# The release CLI loads it automatically; existing shell/CI variables win.
# Never put real secrets in this tracked template. Remove unused empty entries.
# Quote values containing # or spaces. Use single quotes for Windows paths.
IRIS_RELEASE_API=https://example.com/api/releases
IRIS_RELEASE_TOKEN=
IRIS_CERTIFICATE_SHA256=
ANDROID_HOME=D:\AndroidSDK
JAVA_HOME=
IRIS_KEYSTORE_PATH=
IRIS_KEYSTORE_PASSWORD=
IRIS_KEY_ALIAS=
IRIS_KEY_PASSWORD=
EXPO_PUBLIC_BASE_URL=https://example.com/api
EXPO_PUBLIC_RELEASE_API_URL=https://example.com/api/releases

# Optional explicit paths; otherwise run release setup-delta first
IRIS_HDIFFZ_PATH=
IRIS_HPATCHZ_PATH=

# Windows builds default to <project drive>:\iris-build (short ASCII path).
# IRIS_BUILD_ROOT=D:\iris-build
# Optional Ninja >= 1.12.0; default: npm run release -- setup-ninja
# IRIS_NINJA_PATH=D:\tools\ninja.exe

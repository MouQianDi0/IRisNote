{
    "expo": {
        "name": "IRisNote",
        "slug": "irisnote",
        "owner": "mouqiandi",
        "version": "0.2.4",
        "orientation": "portrait",
        "icon": "./assets/images/IRisNote_black.png",
        "scheme": "irisnote",
        "userInterfaceStyle": "automatic",
        "ios": {
            "bundleIdentifier": "com.mouqiandi.irisNote",
            "icon": "./assets/images/IRisNote_black.png"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/IRisNote_iris.png",
                "backgroundImage": "./assets/images/IRisNote_iris.png",
                "monochromeImage": "./assets/images/IRisNote_iris.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.mouqiandi.irisNote",
            "versionCode": 1,
            "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/IRisNote_iris.png"
        },
        "plugins": [
            "./plugins/with-local-notification-entitlements",
            ["expo-notifications", { "icon": "./assets/images/notification-icon.png" }],
            [
                "expo-router",
                {
                    "headers": {
                        "Cross-Origin-Embedder-Policy": "credentialless",
                        "Cross-Origin-Opener-Policy": "same-origin"
                    }
                }
            ],
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#FFFFFF",
                    "android": {
                        "image": "./assets/images/IRisNote_iris.png",
                        "imageWidth": 150
                    },
                    "ios": {
                        "image": "./assets/images/IRisNote_iris.png",
                        "imageWidth": 150
                    },
                    "dark": {
                        "backgroundColor": "#000000",
                        "image": "./assets/images/IRisNote_black.png",
                        "imageWidth": 150
                    }
                }
            ],
            [
                "expo-font",
                {
                    "fonts": [
                        "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
                    ]
                }
            ],
            "react-native-edge-to-edge",
            "expo-image",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow IRisNote to access your photos so you can choose an avatar.",
                    "cameraPermission": "Allow IRisNote to use the camera so you can take an avatar photo.",
                    "microphonePermission": false
                }
            ],
            "expo-sharing",
            "expo-web-browser",
            "expo-sqlite",
            "./plugins/with-release-signing"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {
                "headers": {
                    "Cross-Origin-Embedder-Policy": "credentialless",
                    "Cross-Origin-Opener-Policy": "same-origin"
                }
            },
            "eas": {
                "projectId": "af1689b8-05fe-4160-bf3d-762ec7b00e91"
            }
        }
    }
}

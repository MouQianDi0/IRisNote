{
    "expo": {
        "name": "IRisNote",
        "slug": "IRisNote",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/IRisNote.png",
        "scheme": "irisnote",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/images/IRisNote.png"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/IRisNote.png",
                "backgroundImage": "./assets/images/IRisNote.png",
                "monochromeImage": "./assets/images/IRisNote.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.mouqiandi.IrisNote"
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/IRisNote.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "backgroundColor": "#208AEF",
                    "android": {
                        "image": "./assets/images/splash-icon.png",
                        "imageWidth": 76
                    }
                }
            ],
            [
                "expo-font",
                {
                    "fonts": [
                        "node_modules/@expo-google-fonts/inter/900Black/Inter_900Black.ttf"
                    ]
                }
            ],
            "react-native-edge-to-edge",
            "expo-image",
            [
                "expo-image-picker",
                {
                    "photosPermission": "Allow NextNote to access your photos so you can choose an avatar.",
                    "cameraPermission": "Allow NextNote to use the camera so you can take an avatar photo.",
                    "microphonePermission": false
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {},
            "eas": {
                "projectId": "95b69422-6112-4501-b64c-9b0ea727d950"
            }
        }
    }
}

# Copy this template to the project root as .env.release.local, then fill it in.
# The release CLI loads it automatically; existing shell/CI variables win.
# Never put real secrets in this tracked template. Remove unused empty entries.
# Quote values containing # or spaces. Use single quotes for Windows paths.
IRIS_RELEASE_API=https://tech-mou.top/api/releases # 发布 API 地址
IRIS_RELEASE_TOKEN= # 发布 API 令牌，仅填写本机私有配置
IRIS_CERTIFICATE_SHA256=73:19:B2:56:67:53:52:31:AB:AE:D9:33:FB:CC:EA:28:5D:F1:34:D1:CB:29:C8:1E:33:DF:57:AD:C3:EC:0F:86  # 证书 SHA256 哈希值
ANDROID_HOME= # Android SDK 路径
JAVA_HOME= # Java 路径
IRIS_KEYSTORE_PATH='d:\Note project\IRisNote\irisnote-release.jks' # 证书路径
IRIS_KEYSTORE_PASSWORD= # 正式签名密码
IRIS_KEY_ALIAS=irisnote # 密钥别名
IRIS_KEY_PASSWORD= # 正式密钥密码
EXPO_PUBLIC_BASE_URL=https://tech-mou.top/api # Expo 基础 URL
EXPO_PUBLIC_RELEASE_API_URL=https://tech-mou.top/api/releases # Expo 发布 API 地址
EXPO_PUBLIC_TODO_CLOUD_SYNC=1 # Expo 代办云同步

# Optional explicit paths; otherwise run release setup-delta first 
IRIS_HDIFFZ_PATH= # HDiffz 路径
IRIS_HPATCHZ_PATH= # HPatchz 路径

# COS 双端上传（Node 发布工具专用，不使用 EXPO_PUBLIC_ 前缀）
IRIS_COS_BUCKET=irisnote-1334342309
IRIS_COS_REGION=ap-guangzhou
IRIS_COS_CDN_BASE_URL=https://download.tech-mou.top
IRIS_COS_PREFIX=
IRIS_COS_SECRET_ID=
IRIS_COS_SECRET_KEY=
# 使用临时凭据时还需填写；长期凭据可省略
IRIS_COS_SECURITY_TOKEN=

